{
  "compilerOptions": {
    "target": "ES2023",
    // DOM нужен для addInitScript в e2e-фикстурах: код выполняется в браузере
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "moduleDetection": "force"
  },
  "include": ["vite.config.ts", "playwright.config.ts", "e2e/**/*.ts"]
}
