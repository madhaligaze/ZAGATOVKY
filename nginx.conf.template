# Шаблон конфига: ${PORT} подставляется на старте контейнера.
# Railway сам назначает порт сервису, поэтому вшивать его в образ нельзя.
# Подстановку делает штатный entrypoint nginx (envsubst), а NGINX_ENVSUBST_FILTER
# ограничивает её одной переменной PORT — иначе envsubst съел бы $uri и $host.
server {
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Файлы с хешем в имени не меняются — кэшируем навсегда
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html не кэшируем, иначе пользователи застревают на старой версии
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # SPA-роутинг: любой неизвестный путь отдаёт index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    add_header X-Content-Type-Options nosniff;
    add_header Referrer-Policy strict-origin-when-cross-origin;
}
